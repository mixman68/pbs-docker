FROM debian:trixie-slim

ARG PBS_VERSION=4.1.1-1
ADD --chmod="0644" https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg /usr/share/keyrings/proxmox-archive-keyring.gpg

ADD proxmox.sources /etc/apt/sources.list.d/proxmox.sources

#add key and apt install etc
RUN chmod 644 /etc/apt/trusted.gpg.d/proxmox-release-trixie.gpg && echo "deb http://download.proxmox.com/debian/pbs trixie pbs-no-subscription" > /etc/apt/sources.list.d/proxmox.list \
    && apt-get update && apt-get install -y proxmox-backup-client=${PBS_VERSION} \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
